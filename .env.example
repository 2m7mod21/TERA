# Environment template for TERA Social

# Database Configuration (SQLite during dev, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="secret-change-me-in-production-12345678"

# OAuth Credentials (Stubs during local dev or populate if you have credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# WebSockets / Server Address
NEXT_PUBLIC_WS_URL="http://localhost:3000"

# Node Env
NODE_ENV="development"
